rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'shahbazdawateislami@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Website Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Programs (Residential, Full-Time, Short-Time)
    match /programs/{programId} {
      allow read, write: if true;
    }

    // Classes (Class 1 to 8)
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Admission & Monthly Fee configuration
    match /feeConfig/{configId} {
      allow read, write: if true;
    }

    // Curricular Subjects
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // Curriculum details
    match /curriculum/{curriculumId} {
      allow read, write: if true;
    }

    // Facilities
    match /facilities/{facilityId} {
      allow read, write: if true;
    }

    // Photo Gallery
    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    // Videos, Shorts, Instagram
    match /videos/{videoId} {
      allow read, write: if true;
    }

    // Voice Agent Knowledge Base
    match /voiceAgentKnowledge/{knowledgeId} {
      allow read, write: if true;
    }

    // Hero Carousel Slides
    match /heroSlides/{slideId} {
      allow read, write: if true;
    }

    // Education Structure
    match /structure/{structureId} {
      allow read, write: if true;
    }

    // System Initialization & Seeding Flags
    match /system/{systemId} {
      allow read, write: if true;
    }

    // Admin Users Directory
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admission Enquiries
    match /enquiries/{enquiryId} {
      allow read, write: if true;
    }
  }
}

